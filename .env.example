# Copy to .env for local development. Never commit .env.
# Every value here is a local-development placeholder, not a real secret.

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# APPLICATION role. Non-owner, no BYPASSRLS. This is what the API uses.
DATABASE_URL=postgresql://platform_app:app_local_dev@localhost:5434/platform

# MIGRATOR role. Owns the tables, runs migrations. Never used to serve requests.
DATABASE_MIGRATION_URL=postgresql://platform_migrator:migrator_local_dev@localhost:5434/platform

# Connection pool
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate for real use with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-development-secret-do-not-use-in-production
SESSION_EXPIRY_SECONDS=604800
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Rate limiting / proxy
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Set true ONLY behind the reverse proxy (Caddy) — otherwise clients can
# spoof X-Forwarded-For and rotate rate-limit buckets.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Email (NotificationProvider) — Phase 1 uses the console transport only.
# No external provider is selected. See 12_ARCHITECTURE_DECISIONS_FINAL.md D3.
# ---------------------------------------------------------------------------
NOTIFICATION_TRANSPORT=console
EMAIL_FROM=no-reply@localhost

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_SERVICE_NAME=platform-api

# ---------------------------------------------------------------------------
# Runtime safety limits (Phase 4)
# ---------------------------------------------------------------------------
# Ceilings the intelligence loop enforces in application code. An agent's own
# configuration may narrow these; nothing can widen them. Tunable here so an
# operator can tighten them under cost pressure without a deploy.
RUNTIME_MAX_TOOL_CALLS_PER_TURN=3
RUNTIME_MAX_TOOL_ITERATIONS=3
RUNTIME_MAX_RETRIES=2
RUNTIME_MAX_CONTEXT_CHARS=60000
RUNTIME_MAX_TOOL_OUTPUT_CHARS=8000
RUNTIME_MAX_DURATION_MS=30000
RUNTIME_MAX_HISTORY_MESSAGES=40

# ---------------------------------------------------------------------------
# Benchmark providers (keep in sync with benchmark/.env.benchmark)
# ---------------------------------------------------------------------------
# Used only by `pnpm bench`. Blank = unset. Never commit real keys.
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
GEMINI_API_KEY=
