{
  "name": "@hrvoice/mcp",
  "version": "0.1.0",
  "description": "MCP server (stdio) for HRVoice: create jobs, add candidates, start screening calls and read results from an AI assistant.",
  "license": "MIT",
  "type": "module",
  "bin": { "hrvoice-mcp": "./dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hrvoice/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
