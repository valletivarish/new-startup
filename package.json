{
  "name": "agent-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "pnpm --filter @platform/db generate",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "db:backfill-job-screening": "pnpm --filter @platform/db backfill:job-screening",
    "db:seed": "pnpm --filter @platform/db seed",
    "dev:api": "pnpm --filter @platform/api dev",
    "dev:web": "pnpm --filter @platform/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "pnpm --filter @platform/api test && pnpm --filter @platform/benchmark test",
    "test:watch": "pnpm --filter @platform/api test:watch",
    "test:api": "pnpm --filter @platform/api test",
    "test:ci": "pnpm test:api",
    "telephony:check": "node scripts/check-telephony.mjs",
    "telephony:import": "node scripts/import-india-phone.mjs",
    "demo:telugu-call": "node scripts/demo-telugu-call.mjs",
    "hiring:smoke": "node scripts/hiring-smoke.mjs",
    "ops:check": "node scripts/ops-check.mjs",
    "dev:worker": "pnpm --filter @platform/api dev:worker",
    "bench": "pnpm --filter @platform/benchmark bench"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "fastify": "5.11.3"
    }
  }
}
