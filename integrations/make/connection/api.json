{
  "url": "{{ifempty(parameters.baseUrl, 'https://nexstopp.com/backend')}}/v1/ping",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer {{parameters.apiKey}}"
  },
  "response": {
    "error": {
      "message": "[{{statusCode}}] {{body.message}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.authorization"
    ]
  }
}
