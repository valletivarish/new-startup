{
  "name": "agent-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:generate": "pnpm --filter @platform/db generate",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "db:seed": "pnpm --filter @platform/db seed",
    "dev:api": "pnpm --filter @platform/api dev",
    "dev:web": "pnpm --filter @platform/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "pnpm --filter @platform/api test && pnpm --filter @platform/benchmark test",
    "test:watch": "pnpm --filter @platform/api test:watch",
    "dev:worker": "pnpm --filter @platform/api dev:worker",
    "test:api": "pnpm --filter @platform/api test",
    "bench": "pnpm --filter @platform/benchmark bench"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "fastify": "5.11.3"
    }
  }
}
