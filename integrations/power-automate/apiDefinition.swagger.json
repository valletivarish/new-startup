                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Candidate"
                  }
                },
                "nextCursor": {
                  "type": "string",
                  "x-nullable": true
                }
              },
              "required": [
                "candidates",
                "nextCursor"
              ]
