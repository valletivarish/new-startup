              "operationId": "ListJobs",
              "value-collection": "jobs",
              "value-path": "id",
              "value-title": "title"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50,
            "x-ms-summary": "limit"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "type": "string",
            "x-ms-summary": "cursor"
          },
          {
            "name": "externalId",
            "in": "query",
