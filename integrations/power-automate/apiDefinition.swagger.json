            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CandidateCreate"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Existing candidate updated by externalId",
            "schema": {
              "$ref": "#/definitions/CandidateCreated"
            }
          },
          "201": {
            "description": "Created (single candidate, or a batch)",
            "schema": {
              "$ref": "#/definitions/CandidateCreated"
            }
          },
          "401": {
            "description": "unauthorized: missing or invalid API key.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "403": {
            "description": "forbidden: the key lacks the scope for this route.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "not_found (for a candidate link: unknown, used or expired).",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "conflict, agent_required, idempotency_in_progress, delivery_in_progress or link_phone_conflict.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "422": {
            "description": "validation_failed, or consent_required when a candidate is created without \"consent\": true.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "internal.",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      },
      "get": {
        "operationId": "FindCandidates",
        "summary": "Find candidates",
        "description": "Lists a job's candidates, or only those matching your external ID or a phone number.",
        "x-ms-visibility": "advanced",
