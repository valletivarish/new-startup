    "/v1/webhook-endpoints": {
      "post": {
        "operationId": "WhenCallEnds",
        "summary": "When a screening call ends",
        "description": "Triggers when a screening call completes (answers, summary, transcript) or fails (no answer, busy, voicemail, too short, skipped).",
        "x-ms-visibility": "important",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "url",
                "events"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "x-ms-notification-url": true,
                  "x-ms-visibility": "internal",
                  "title": "Callback URL"
                },
                "events": {
                  "type": "array",
                  "title": "Events",
                  "description": "Which call outcomes start the flow.",
                  "items": {
                    "type": "string",
                    "enum": [
                      "call.completed",
                      "call.failed"
                    ]
                  },
                  "default": [
                    "call.completed",
                    "call.failed"
                  ]
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created. Location is the endpoint's URL (DELETE it to unsubscribe).",
            "schema": {
