# Copy to .env for local development. Never commit .env.
# Every value here is a local-development placeholder, not a real secret.

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# APPLICATION role. Non-owner, no BYPASSRLS. This is what the API uses.
DATABASE_URL=postgresql://platform_app:app_local_dev@localhost:5434/platform

# MIGRATOR role. Owns the tables, runs migrations. Never used to serve requests.
DATABASE_MIGRATION_URL=postgresql://platform_migrator:migrator_local_dev@localhost:5434/platform

# Compose first-boot role passwords (only applied when the Postgres volume is new).
# POSTGRES_PASSWORD=postgres_local_dev
# POSTGRES_MIGRATOR_PASSWORD=migrator_local_dev
# POSTGRES_APP_PASSWORD=app_local_dev

# Connection pool
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Job JD assist (generate from roles / format pasted text on Screening setup).
# Optional — leave blank to type/save JD without AI. Prefer a paid AI Studio key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Staging / production behind Caddy (single public hostname):
#   API_URL and WEB_URL must be the SAME origin, e.g. https://hiring.example.com
#   (see DOMAIN block below). Split api./app. hosts are not supported by this
#   compose TLS profile — same-origin /backend + cookies require one domain.
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Local object storage for knowledge uploads (PDF/DOCX/PPTX).
# In docker compose --profile app, api + worker share STORAGE_ROOT=/app/.storage
# via the platform-storage volume — keep the same path on both.
# Production: STORAGE_BACKEND=s3 with R2/S3 (ADR-006) before real customer PII.
STORAGE_BACKEND=local
STORAGE_ROOT=
# S3_BUCKET=hiring-docs
# S3_REGION=auto
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate for real use with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-development-secret-do-not-use-in-production
SESSION_EXPIRY_SECONDS=604800
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Rate limiting / proxy
# ---------------------------------------------------------------------------
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
# Set true ONLY behind the reverse proxy (Caddy) — otherwise clients can
# spoof X-Forwarded-For and rotate rate-limit buckets.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Email (NotificationProvider)
# Local/dev: console (links print in API/worker logs).
# Production: NOTIFICATION_TRANSPORT=smtp (required) + SMTP_URL or SMTP_HOST.
# ---------------------------------------------------------------------------
NOTIFICATION_TRANSPORT=console
EMAIL_FROM=no-reply@localhost
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ---------------------------------------------------------------------------
# Public TLS edge (ADR-006 Caddy) — docker compose --profile app --profile tls
# Point DNS at the VPS first. Then set API_URL/WEB_URL to https://{DOMAIN}.
# ---------------------------------------------------------------------------
# DOMAIN=hiring.example.com
# ACME_EMAIL=ops@example.com
# API_URL=https://hiring.example.com
# WEB_URL=https://hiring.example.com
# COOKIE_SECURE=true
# TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_SERVICE_NAME=platform-api
# When OTEL_ENABLED=true, set the collector (OTLP HTTP). Example:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# The SDK reads OTEL_EXPORTER_OTLP_ENDPOINT from the environment automatically.

# ---------------------------------------------------------------------------
# Runtime safety limits (Phase 4)
# ---------------------------------------------------------------------------
# Ceilings the intelligence loop enforces in application code. An agent's own
# configuration may narrow these; nothing can widen them. Tunable here so an
# operator can tighten them under cost pressure without a deploy.
RUNTIME_MAX_TOOL_CALLS_PER_TURN=3
RUNTIME_MAX_TOOL_ITERATIONS=3
RUNTIME_MAX_RETRIES=2
RUNTIME_MAX_CONTEXT_CHARS=60000
RUNTIME_MAX_TOOL_OUTPUT_CHARS=8000
RUNTIME_MAX_DURATION_MS=30000
RUNTIME_MAX_HISTORY_MESSAGES=40

# ---------------------------------------------------------------------------
# MVP-01 ElevenLabs browser-voice
# ---------------------------------------------------------------------------
# ELEVENLABS_ENABLED=false keeps the feature entirely off (no spend, no error)
# until you explicitly turn it on. Set to true to enable.
ELEVENLABS_ENABLED=false

# Required when ELEVENLABS_ENABLED=true
ELEVENLABS_API_KEY=
# Signing secret from the voice console webhook. Register URL:
#   {API_URL}/webhooks/elevenlabs  (public HTTPS in staging/production)
ELEVENLABS_WEBHOOK_SECRET=

# Optional: default voice assigned to provisioned agents.
ELEVENLABS_DEFAULT_VOICE_ID=

# Linked phone number id (enables Call phone). Leave blank to keep outbound blocked.
# India production: Exotel KYC + paid number (open outbound to any candidate phone from resumes).
# Import that number in the voice console → paste id here → ELEVENLABS_OUTBOUND_PROVIDER=india.
# Helper: pnpm telephony:import (lists) / pnpm telephony:import -- --import (needs EXOTEL_* below).
# Trial accounts may restrict destinations; that is a carrier limit, not a product whitelist.
ELEVENLABS_PHONE_NUMBER_ID=
# india = India-linked carrier path (Exotel in the adapter); primary = international path
ELEVENLABS_OUTBOUND_PROVIDER=india

# Set true only after carrier business verification unlocks dialing any resume number
# (not trial verified-only). Controls desk messaging; restart API after changing.
TELEPHONY_OPEN_OUTBOUND=false

# Operator + compose (DID import script and api env passthrough for India outbound).
# EXOTEL_PHONE_NUMBER=+91XXXXXXXXXX
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_APP_ID=   # MUST be Exotel Voicebot applet id (not Landing Flow / Sales)
# EXOTEL_API_SUBDOMAIN=api.in.exotel.com
# EXOTEL_LABEL="India hiring outbound"

# Cost guards (defaults apply when not set)
# Browser demos stay tightly capped; live phone screens use separate limits.
ELEVENLABS_MAX_TEST_MINUTES=5
ELEVENLABS_DAILY_TEST_SESSIONS=10
ELEVENLABS_DAILY_TEST_MINUTES=30
ELEVENLABS_MAX_PHONE_MINUTES=20
ELEVENLABS_MAX_CONCURRENT_PHONE=3
ELEVENLABS_DAILY_PHONE_SESSIONS=50

# ---------------------------------------------------------------------------
# Benchmark providers (keep in sync with benchmark/.env.benchmark)
# ---------------------------------------------------------------------------
# Used only by `pnpm bench`. Blank = unset. Never commit real keys.
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
GEMINI_API_KEY=
